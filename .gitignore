# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
build/

# Test artifacts
playwright-report/
test-results/
coverage/

# Environment files — catches .env, .env.local, backend/.env, backend/.env.backup, etc.
.env*
!.env.example
!**/.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
.eslintcache
*.tsbuildinfo

# startup.sh runtime state
.run/

# iOS (Capacitor/Xcode) — ios/ itself is tracked (native project source),
# but not build products, user-specific settings, or SPM's resolved cache.
ios/App/build/
ios/App/Pods/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
ios/**/*.xcuserstate
ios/DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
# Synced web build (byte-for-byte copy of dist/, ~27MB incl. the
# background-removal WASM model) — regenerate with:
#   npm run build && npx cap sync ios
ios/App/App/public/
